{
    "name": "rusted",
    "displayName": "rusted",
    "publisher": "sph1nxis",
    "description": "A dark theme inspired by the color palette of The Rust Programming Language code snippets and rusty.nvim",
    "version": "1.2.0",
    "icon": "assets/images/icon.png",
    "license": "MIT",

    "engines": {
        "vscode": "^1.70.0"
    },

    "categories": [
        "Themes"
    ],

    "keywords": [
        "dark theme",
        "code theme",
        "editor theme",
        "syntax highlighting",
        "semantic highlighting",
        "minimal",
        "minimalist",
        "rust",
        "rust theme",
        "rust inspired",
        "rust documentation",
        "rusty.nvim",
        "tomorrow night rusty",
        "neovim",
        "c",
        "cpp",
        "c++",
        "go",
        "python",
        "javascript",
        "typescript",
        "java",
        "kotlin",
        "dart",
        "lua",
        "ruby",
        "php",
        "swift",
        "yaml",
        "dockerfile"
    ],

    "repository": {
        "type": "git",
        "url": "https://github.com/sph1nxis/rusted"
    },

    "homepage": "https://github.com/sph1nxis/rusted",

    "bugs": {
        "url": "https://github.com/sph1nxis/rusted/issues"
    },

    "qna": "https://github.com/sph1nxis/rusted/issues",

    "galleryBanner": {
        "color": "#17191b",
        "theme": "dark"
    },

    "extensionKind": ["ui"],

    "scripts": {
        "build": "python3 scripts/build.py",
        "watch": "python3 scripts/watch.py"
    },

    "contributes": {
        "themes": [
            {
                "label": "rusted",
                "uiTheme": "vs-dark",
                "path": "./themes/rusted.json"
            }
        ]
    }
}

